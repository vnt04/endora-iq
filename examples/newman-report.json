{
  "collection": {
    "info": {
      "name": "Demo User API"
    }
  },
  "run": {
    "stats": {
      "assertions": {
        "total": 6,
        "failed": 2,
        "pending": 0
      }
    },
    "executions": [
      {
        "item": {
          "name": "List Users"
        },
        "request": {
          "method": "GET",
          "url": {
            "raw": "https://api.example.com/v1/users?page=1&limit=20"
          }
        },
        "response": {
          "code": 200,
          "status": "OK",
          "responseTime": 142
        },
        "assertions": [
          {
            "assertion": "status is 200"
          },
          {
            "assertion": "responds within 800ms"
          },
          {
            "assertion": "body has data array"
          }
        ]
      },
      {
        "item": {
          "name": "Get User"
        },
        "request": {
          "method": "GET",
          "url": {
            "raw": "https://api.example.com/v1/users/u_1"
          }
        },
        "response": {
          "code": 200,
          "status": "OK",
          "responseTime": 98
        },
        "assertions": [
          {
            "assertion": "status is 200"
          },
          {
            "assertion": "user has email",
            "error": {
              "name": "AssertionError",
              "message": "expected { id: 'u_1', email_address: 'ada@example.com' } to have property 'email'"
            }
          }
        ]
      },
      {
        "item": {
          "name": "Create User"
        },
        "request": {
          "method": "POST",
          "url": {
            "raw": "https://api.example.com/v1/users"
          }
        },
        "response": {
          "code": 422,
          "status": "Unprocessable Entity",
          "responseTime": 211
        },
        "assertions": [
          {
            "assertion": "status is 201",
            "error": {
              "name": "AssertionError",
              "message": "expected response to have status code 201 but got 422"
            }
          }
        ]
      }
    ]
  }
}
