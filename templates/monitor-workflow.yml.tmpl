name: ApiLens API Monitor

# Generated by ApiLens (apilens monitor init). Monitoring mode: [[.Mode]].
# Customize the collection/environment paths in the "Run Newman" step below.
#
# REFERENCE COPY. Source of truth: internal/monitor/templates.go (workflowTemplate).
# Rendered with text/template using "[[" / "]]" delimiters so GitHub's own
# "${{ ... }}" expression syntax passes through verbatim.

on:
  schedule:
    - cron: '[[.Cron]]'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  monitor:
    name: Run API monitoring
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Newman
        run: npm install -g newman newman-reporter-htmlextra

      - name: Prepare reports directory
        run: mkdir -p reports

      - name: Run Newman
        id: newman
        # TODO: point these at your collection and environment files.
        run: |
          newman run ./collection.json \
            --environment ./environment.json \
            --reporters cli,json,htmlextra \
            --reporter-json-export reports/newman-report.json \
            --reporter-htmlextra-export reports/newman-report.html

      - name: Upload monitoring reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: apilens-monitor-reports
          path: reports/
          if-no-files-found: warn
[[- range .Notify]]
[[- if eq . "slack"]]

      - name: Notify Slack on failure
        if: failure()
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
        run: |
          curl -sf -X POST -H 'Content-Type: application/json' \
            -d '{"text":"[ApiLens] Monitor FAILED for ${{ github.repository }} (run ${{ github.run_id }}): ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"}' \
            "$SLACK_WEBHOOK_URL"
[[- end]]
[[- if eq . "discord"]]

      - name: Notify Discord on failure
        if: failure()
        env:
          DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
        run: |
          curl -sf -X POST -H 'Content-Type: application/json' \
            -d '{"content":"[ApiLens] Monitor FAILED for ${{ github.repository }} (run ${{ github.run_id }}): ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"}' \
            "$DISCORD_WEBHOOK_URL"
[[- end]]
[[- if eq . "telegram"]]

      - name: Notify Telegram on failure
        if: failure()
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: |
          curl -sf -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
            --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
            --data-urlencode "text=[ApiLens] Monitor FAILED for ${{ github.repository }} (run ${{ github.run_id }})"
[[- end]]
[[- if eq . "email"]]

      - name: Notify Email on failure
        if: failure()
        uses: dawidd6/action-send-mail@v3
        with:
          server_address: ${{ secrets.SMTP_HOST }}
          server_port: ${{ secrets.SMTP_PORT }}
          username: ${{ secrets.SMTP_USERNAME }}
          password: ${{ secrets.SMTP_PASSWORD }}
          subject: '[ApiLens] Monitor FAILED for ${{ github.repository }}'
          to: ${{ secrets.SMTP_TO }}
          from: ApiLens Monitor <${{ secrets.SMTP_FROM }}>
          body: |
            ApiLens monitoring run ${{ github.run_id }} failed for ${{ github.repository }}.
            Review the uploaded "apilens-monitor-reports" artifact for the Newman report.
            Run: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
[[- end]]
[[- end]]
