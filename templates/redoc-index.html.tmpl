<!DOCTYPE html>
<!--
  REFERENCE COPY. Source of truth: internal/docs/html.go (redocHTMLTemplate).
  Rendered with html/template (default "{{" / "}}" delimiters). All dynamic values
  pass through html/template's context-aware escaping; the Redoc options object is
  pre-marshaled JSON, preventing script-context injection from flag values.

  Fields: .Title .Logo .HeaderColor .ScriptURL .SpecURL .Options
-->
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{{.Title}}</title>
  <style>
    body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    header.apilens-banner { display: flex; align-items: center; gap: 12px; padding: 12px 20px; color: #fff; background: {{.HeaderColor}}; }
    header.apilens-banner img { height: 32px; width: auto; }
    header.apilens-banner h1 { font-size: 18px; margin: 0; font-weight: 600; }
  </style>
</head>
<body>
  <header class="apilens-banner">
    {{if .Logo}}<img src="{{.Logo}}" alt="logo"/>{{end}}
    <h1>{{.Title}}</h1>
  </header>
  <div id="redoc"></div>
  <script src="{{.ScriptURL}}"></script>
  <script>
    Redoc.init({{.SpecURL}}, {{.Options}}, document.getElementById("redoc"));
  </script>
</body>
</html>
